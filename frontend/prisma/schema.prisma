generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id           String    @id @default(uuid())
  nome         String
  nomeFantasia String?
  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  clientes     Cliente[]
  pedidos      Pedido[]

  @@index([ativo])
}

model Cliente {
  id                   String     @id @default(uuid())
  empresaId            String
  nome                 String
  telefone             String
  cpf                  String
  email                String?
  dataNascimento       DateTime?
  origemPrimeiroPedido String?
  ultimoPedidoEm       DateTime?
  quantidadePedidos    Int        @default(0)
  valorTotalCompras    Decimal    @default(0) @db.Decimal(12, 2)
  ticketMedio          Decimal    @default(0) @db.Decimal(12, 2)
  ativo                Boolean    @default(true)
  criadoEm             DateTime   @default(now())
  atualizadoEm         DateTime   @updatedAt

  empresa              Empresa    @relation(fields: [empresaId], references: [id])
  enderecos            Endereco[]
  pedidos              Pedido[]

  @@unique([empresaId, telefone])
  @@unique([empresaId, cpf])
  @@index([empresaId])
  @@index([empresaId, ativo])
}

model Endereco {
  id           String   @id @default(uuid())
  clienteId    String
  rotulo       String
  principal    Boolean  @default(false)
  cep          String?
  logradouro   String
  numero       String
  complemento  String?
  bairro       String
  cidade       String
  estado       String
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  cliente      Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  pedidos      Pedido[]

  @@index([clienteId])
  @@index([clienteId, principal])
}

model Pedido {
  id                   String   @id @default(uuid())
  empresaId            String
  clienteId            String
  numero               String
  canal                String
  entrada              String
  subtotal             Decimal  @db.Decimal(12, 2)
  descontos            Decimal  @default(0) @db.Decimal(12, 2)
  taxaEntrega          Decimal  @default(0) @db.Decimal(12, 2)
  total                Decimal  @db.Decimal(12, 2)
  distanciaEntregaKm   Decimal? @db.Decimal(8, 2)
  regraEntregaAplicada String?
  statusOperacional    String
  enderecoEntregaId    String?

  enderecoRotulo      String?
  enderecoCep         String?
  enderecoLogradouro  String?
  enderecoNumero      String?
  enderecoComplemento String?
  enderecoBairro      String?
  enderecoCidade      String?
  enderecoEstado      String?
  enderecoLatitude    Decimal? @db.Decimal(10, 7)
  enderecoLongitude   Decimal? @db.Decimal(10, 7)

  criadoEm        DateTime     @default(now())
  atualizadoEm    DateTime     @updatedAt
  pagamentos      Pagamento[]
  cliente         Cliente      @relation(fields: [clienteId], references: [id])
  empresa         Empresa      @relation(fields: [empresaId], references: [id])
  enderecoEntrega Endereco?    @relation(fields: [enderecoEntregaId], references: [id], onDelete: Restrict)
  itens           PedidoItem[]

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@index([empresaId, clienteId])
  @@index([empresaId, statusOperacional])
  @@index([clienteId, criadoEm])
}

model PedidoItem {
  id            String   @id @default(uuid())
  pedidoId      String
  produtoId     String?
  nome          String
  quantidade    Int
  precoUnitario Decimal  @db.Decimal(12, 2)
  subtotal      Decimal  @db.Decimal(12, 2)
  observacao    String?
  criadoEm      DateTime @default(now())
  pedido        Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
}

model Pagamento {
  id                      String    @id @default(uuid())
  pedidoId                String
  modalidade              String
  forma                   String
  status                  String
  origem                  String
  valor                   Decimal   @db.Decimal(12, 2)
  cobrancaNoPdvHabilitada Boolean   @default(false)
  confirmacaoAutomatica   Boolean   @default(false)
  criadoEm                DateTime  @default(now())
  aprovadoEm              DateTime?
  atualizadoEm            DateTime  @updatedAt
  pedido                  Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@index([status])
  @@index([forma, status])
}
