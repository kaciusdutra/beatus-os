generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id               String            @id @default(uuid())
  nome             String
  nomeFantasia     String?
  ativo            Boolean           @default(true)
  criadoEm         DateTime          @default(now())
  atualizadoEm     DateTime          @updatedAt
  clientes         Cliente[]
  pedidos          Pedido[]
  produtos         Produto[]
  fornecedores     Fornecedor[]
  entradasCompra   EntradaCompra[]
  insumos          Insumo[]
  fichasTecnicas   FichaTecnica[]
  categoriasInsumo CategoriaInsumo[]
  unidadesMedida   UnidadeMedida[]

  classificacoesItemCompra ClassificacaoItemCompra[]

  custosFixos             CustoFixo[]
  configuracaoPrecificacao ConfiguracaoPrecificacao?
  canaisPrecificacao      CanalPrecificacao[]
  precosProduto           PrecoProduto[]

  @@index([ativo])
}

model Fornecedor {
  id           String   @id @default(uuid())
  empresaId    String
  razaoSocial  String
  nomeFantasia String?
  cnpj         String?
  cpf          String?
  telefone     String?
  email        String?
  observacao   String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Destino sugerido para os itens deste fornecedor quando não houver memória.
  destinoPadrao String?

  // Dados da nota fiscal e do endereço (bloco 7E).
  inscricaoEstadual String?
  cep               String?
  logradouro        String?
  numero            String?
  complemento       String?
  bairro            String?
  municipio         String?
  uf                String?

  empresa        Empresa         @relation(fields: [empresaId], references: [id])
  entradasCompra EntradaCompra[]
  insumos        Insumo[]

  classificacoesItemCompra ClassificacaoItemCompra[]

  @@unique([empresaId, cnpj])
  @@unique([empresaId, cpf])
  @@index([empresaId])
  @@index([empresaId, ativo])
}

model EntradaCompra {
  id           String @id @default(uuid())
  empresaId    String
  fornecedorId String

  tipoDocumento   String
  numeroDocumento String?
  serie           String?
  chaveAcesso     String?

  status String @default("RASCUNHO")

  dataDocumento DateTime?
  dataEntrada   DateTime  @default(now())

  valorProdutos Decimal @default(0) @db.Decimal(12, 2)
  valorDesconto Decimal @default(0) @db.Decimal(12, 2)
  valorFrete    Decimal @default(0) @db.Decimal(12, 2)

  // Impostos e outras despesas da nota: ficam à parte, fora do custo (regra 7.25).
  valorIcmsSt         Decimal @default(0) @db.Decimal(12, 2)
  valorIpi            Decimal @default(0) @db.Decimal(12, 2)
  valorSeguro         Decimal @default(0) @db.Decimal(12, 2)
  valorOutrasDespesas Decimal @default(0) @db.Decimal(12, 2)

  valorTotal    Decimal @default(0) @db.Decimal(12, 2)

  documentoArquivo String?
  observacao       String?

  documentos EntradaCompraDocumento[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa    Empresa             @relation(fields: [empresaId], references: [id])
  fornecedor Fornecedor          @relation(fields: [fornecedorId], references: [id])
  itens      EntradaCompraItem[]

  @@index([empresaId])
  @@index([empresaId, fornecedorId])
  @@index([empresaId, dataEntrada])
  @@index([empresaId, tipoDocumento])
  @@index([empresaId, status])
}

model EntradaCompraItem {
  id              String @id @default(uuid())
  entradaCompraId String

  descricaoOriginal String
  codigoFornecedor  String?

  quantidade Decimal @db.Decimal(12, 3)
  unidade    String

  valorUnitario Decimal @db.Decimal(12, 4)
  desconto      Decimal @default(0) @db.Decimal(12, 2)
  valorTotal    Decimal @db.Decimal(12, 2)

  lote     String?
  validade DateTime?

  observacao String?

  // INSUMO | EMBALAGEM | LIMPEZA_HIGIENE | EXPEDIENTE | EQUIPAMENTO_UTENSILIO | SERVICO
  // Vazio = item ainda não classificado.
  destino  String?
  insumoId String?

  // Quanto a compra vale na unidade de compra do insumo (bloco 8C). Serve ao estoque.
  quantidadeConvertida Decimal? @db.Decimal(14, 4)
  unidadeConvertida    String?

  // Quantidade real informada na entrada (ex.: 6,8 kg de 3 mantas). Tem prioridade no custo.
  quantidadeReal Decimal? @db.Decimal(14, 4)
  unidadeReal    String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  historicoPreco HistoricoPrecoInsumo?

  entradaCompra EntradaCompra @relation(fields: [entradaCompraId], references: [id], onDelete: Cascade)

  insumo Insumo? @relation(fields: [insumoId], references: [id])

  @@index([entradaCompraId])
  @@index([insumoId])
}

// Memória de classificação: descrição do item + fornecedor -> destino (e insumo).
model ClassificacaoItemCompra {
  id String @id @default(uuid())

  empresaId    String
  fornecedorId String

  // Descrição em maiúsculas, sem acentos e sem espaços repetidos.
  descricaoNormalizada String

  destino  String
  insumoId String?

  // Fator fixo lembrado: 1 unidade do item = fatorQuantidade fatorUnidade (ex.: 1 cx = 12 un).
  fatorQuantidade Decimal? @db.Decimal(14, 4)
  fatorUnidade    String?

  vezesUsada Int @default(1)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa    Empresa    @relation(fields: [empresaId], references: [id])
  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id])
  insumo     Insumo?    @relation(fields: [insumoId], references: [id])

  @@unique([empresaId, fornecedorId, descricaoNormalizada])
  @@index([empresaId])
  @@index([insumoId])
}

model EntradaCompraDocumento {
  id              String @id @default(uuid())
  entradaCompraId String

  nomeArquivo String
  mimeType    String
  tamanho     Int

  tipoDocumento String
  origem        String
  statusLeitura String @default("PENDENTE")

  caminhoArquivo String
  hashArquivo    String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  entradaCompra EntradaCompra @relation(fields: [entradaCompraId], references: [id], onDelete: Cascade)

  @@index([entradaCompraId])
  @@index([entradaCompraId, tipoDocumento])
  @@index([entradaCompraId, statusLeitura])
}

model Produto {
  id           String   @id
  empresaId    String
  nome         String
  descricao    String
  categoria    String
  preco        Decimal  @db.Decimal(12, 2)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  itens        PedidoItem[]
  fichaTecnica FichaTecnica?
  precos       PrecoProduto[]

  @@index([empresaId])
  @@index([empresaId, ativo])
  @@index([empresaId, categoria])
}

model Cliente {
  id                   String    @id @default(uuid())
  empresaId            String
  nome                 String
  telefone             String
  cpf                  String
  email                String?
  dataNascimento       DateTime?
  origemPrimeiroPedido String?
  ultimoPedidoEm       DateTime?
  quantidadePedidos    Int       @default(0)
  valorTotalCompras    Decimal   @default(0) @db.Decimal(12, 2)
  ticketMedio          Decimal   @default(0) @db.Decimal(12, 2)
  ativo                Boolean   @default(true)
  criadoEm             DateTime  @default(now())
  atualizadoEm         DateTime  @updatedAt

  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  enderecos Endereco[]
  pedidos   Pedido[]

  @@unique([empresaId, telefone])
  @@unique([empresaId, cpf])
  @@index([empresaId])
  @@index([empresaId, ativo])
}

model Endereco {
  id           String   @id @default(uuid())
  clienteId    String
  rotulo       String
  principal    Boolean  @default(false)
  cep          String?
  logradouro   String
  numero       String
  complemento  String?
  bairro       String
  cidade       String
  estado       String
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  cliente      Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  pedidos      Pedido[]

  @@index([clienteId])
  @@index([clienteId, principal])
}

model Pedido {
  id                   String   @id @default(uuid())
  empresaId            String
  clienteId            String
  numero               String
  canal                String
  entrada              String
  subtotal             Decimal  @db.Decimal(12, 2)
  descontos            Decimal  @default(0) @db.Decimal(12, 2)
  taxaEntrega          Decimal  @default(0) @db.Decimal(12, 2)
  total                Decimal  @db.Decimal(12, 2)
  distanciaEntregaKm   Decimal? @db.Decimal(8, 2)
  regraEntregaAplicada String?
  statusOperacional    String
  enderecoEntregaId    String?

  enderecoRotulo      String?
  enderecoCep         String?
  enderecoLogradouro  String?
  enderecoNumero      String?
  enderecoComplemento String?
  enderecoBairro      String?
  enderecoCidade      String?
  enderecoEstado      String?
  enderecoLatitude    Decimal? @db.Decimal(10, 7)
  enderecoLongitude   Decimal? @db.Decimal(10, 7)

  criadoEm        DateTime     @default(now())
  atualizadoEm    DateTime     @updatedAt
  pagamentos      Pagamento[]
  cliente         Cliente      @relation(fields: [clienteId], references: [id])
  empresa         Empresa      @relation(fields: [empresaId], references: [id])
  enderecoEntrega Endereco?    @relation(fields: [enderecoEntregaId], references: [id], onDelete: Restrict)
  itens           PedidoItem[]

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@index([empresaId, clienteId])
  @@index([empresaId, statusOperacional])
  @@index([clienteId, criadoEm])
}

model PedidoItem {
  id            String   @id @default(uuid())
  pedidoId      String
  produtoId     String?
  nome          String
  quantidade    Int
  precoUnitario Decimal  @db.Decimal(12, 2)
  subtotal      Decimal  @db.Decimal(12, 2)
  observacao    String?
  criadoEm      DateTime @default(now())
  pedido        Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto       Produto? @relation(fields: [produtoId], references: [id])

  @@index([pedidoId])
}

model Pagamento {
  id                      String    @id @default(uuid())
  pedidoId                String
  modalidade              String
  forma                   String
  status                  String
  origem                  String
  valor                   Decimal   @db.Decimal(12, 2)
  cobrancaNoPdvHabilitada Boolean   @default(false)
  confirmacaoAutomatica   Boolean   @default(false)
  criadoEm                DateTime  @default(now())
  aprovadoEm              DateTime?
  atualizadoEm            DateTime  @updatedAt
  pedido                  Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@index([status])
  @@index([forma, status])
}

// Custo fixo mensal (regra 7.6): mão de obra, gás, energia, aluguel, internet etc.
model CustoFixo {
  id String @id @default(uuid())

  empresaId String

  nome        String
  valorMensal Decimal @db.Decimal(12, 2)

  inicioVigencia DateTime  @default(now())
  fimVigencia    DateTime?

  ativo Boolean @default(true)

  observacao String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
  @@index([empresaId, ativo])
}

// Base do rateio dos custos fixos por pedido (regra 7.6).
model ConfiguracaoPrecificacao {
  id String @id @default(uuid())

  empresaId String @unique

  // Estimativa de pedidos por mês, até haver pedidos reais suficientes.
  pedidosMensaisEstimados Int @default(0)

  // Percentuais sobre o preço, embutidos seja qual for a forma de pagamento (regra 4.5).
  impostoPercentual        Decimal @default(0) @db.Decimal(8, 4)
  taxaPagamentoPercentual  Decimal @default(0) @db.Decimal(8, 4)

  // Embalagem do pedido (sacola, guardanapo, sachê), em R$ por pedido (regra 7.19).
  embalagemPedido Decimal @default(0) @db.Decimal(12, 4)

  // Quantos produtos, em média, vão em um pedido (rateia o custo fixo por pedido).
  itensPorPedidoEstimados Decimal @default(1) @db.Decimal(8, 2)

  // Margens que a tela mostra lado a lado, separadas por vírgula (decisão do Kacius: 20, 25, 30 e 35).
  margensCenario String @default("20,25,30,35")

  // Abaixo desta margem o preço conta como promoção (o Kacius trabalha de 20% para cima).
  margemMinimaPercentual Decimal @default(20) @db.Decimal(8, 4)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
}

// Percentuais e taxas de cada canal de venda (iFood, 99Food, Keeta, WhatsApp, site).
model CanalPrecificacao {
  id String @id @default(uuid())

  empresaId String

  canal String

  comissaoPercentual Decimal @default(0) @db.Decimal(8, 4)

  // Taxa fixa por mês do canal (iFood: R$ 150), tratada como custo de aquisição.
  taxaMensal Decimal @default(0) @db.Decimal(12, 2)

  // Pedidos esperados por mês no canal (rateia a taxa mensal).
  pedidosMensaisEstimados Int @default(0)

  ativo Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, canal])
  @@index([empresaId])
}

// Preço de venda de um produto em um canal (regra 6.6: vem da precificação).
model PrecoProduto {
  id String @id @default(uuid())

  empresaId String
  produtoId String

  canal String

  preco Decimal @db.Decimal(12, 2)

  // Custo total do produto e margem no momento em que o preço foi fixado.
  // Servem ao aviso de impacto (o custo mudou desde então).
  custoReferencia  Decimal? @db.Decimal(12, 4)
  margemReferencia Decimal? @db.Decimal(8, 4)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@unique([empresaId, produtoId, canal])
  @@index([empresaId])
  @@index([produtoId])
}

model Insumo {
  id String @id @default(uuid())

  empresaId String

  nome        String
  categoriaId String?

  unidadeCompraId String?

  quantidadeCompra Decimal @db.Decimal(12, 3)
  precoCompra      Decimal @db.Decimal(12, 4)
  custoUnitario    Decimal @db.Decimal(12, 4)

  // Equivalência da unidade de compra em outra unidade de uso (bloco 8B).
  // Exemplos: 1 pct = 6 un; 1 maço = 150 g; 1 frasco = 300 pump.
  equivalenciaQuantidade Decimal? @db.Decimal(12, 4)
  equivalenciaUnidade    String?

  // Perda de limpeza do insumo (casca, osso, aparas), em %. Vale em qualquer ficha.
  perdaLimpeza Decimal @default(0) @db.Decimal(8, 4)

  fornecedorId String?

  ativo Boolean @default(true)

  observacao String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])

  fornecedor Fornecedor? @relation(fields: [fornecedorId], references: [id])

  categoriaInsumo CategoriaInsumo? @relation(fields: [categoriaId], references: [id])

  unidadeMedida UnidadeMedida? @relation(fields: [unidadeCompraId], references: [id])

  fichaTecnicaItens FichaTecnicaItem[]
  historicoPrecos   HistoricoPrecoInsumo[]

  itensEntradaCompra       EntradaCompraItem[]
  classificacoesItemCompra ClassificacaoItemCompra[]

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@index([empresaId, ativo])
  @@index([empresaId, fornecedorId])
}

// Histórico do custo do insumo: uma linha por item de compra confirmado (bloco 8C).
model HistoricoPrecoInsumo {
  id String @id @default(uuid())

  empresaId String
  insumoId  String

  entradaCompraItemId String @unique

  dataCompra DateTime

  // Preço pago por 1 unidade de compra do insumo (desconto do item incluído).
  precoPorUnidade Decimal @db.Decimal(14, 4)

  // Custo do insumo antes desta compra (para voltar ao cancelar).
  custoAnterior Decimal @db.Decimal(14, 4)

  criadoEm DateTime @default(now())

  insumo            Insumo            @relation(fields: [insumoId], references: [id])
  entradaCompraItem EntradaCompraItem @relation(fields: [entradaCompraItemId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([insumoId, dataCompra])
}

model FichaTecnica {
  id                String   @id @default(uuid())
  empresaId         String
  tipo              String   @default("PRODUTO")
  produtoId         String?  @unique
  nome              String
  rendimento        Decimal? @db.Decimal(12, 3)
  unidadeRendimento String?
  embalagem         Decimal  @default(0) @db.Decimal(12, 4)
  ativo             Boolean  @default(true)
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  // Bloco 8E: o que o funcionário lê na cozinha.
  modoPreparo      String? @db.Text
  montagem         String? @db.Text
  observacoes      String? @db.Text
  validadeDias     Int?
  tempoPreparoMin  Int?
  porcaoQuantidade Decimal? @db.Decimal(12, 4)
  porcaoUnidade    String?

  empresa             Empresa            @relation(fields: [empresaId], references: [id])
  produto             Produto?           @relation(fields: [produtoId], references: [id])
  itens               FichaTecnicaItem[]
  itensComoPreparacao FichaTecnicaItem[] @relation("FichaTecnicaPreparacao")

  @@index([empresaId])
  @@index([empresaId, produtoId])
  @@index([empresaId, tipo])
}

model FichaTecnicaItem {
  id              String   @id @default(uuid())
  fichaTecnicaId  String
  tipo            String   @default("INSUMO")
  insumoId        String?
  preparacaoId    String?
  quantidade      Decimal  @db.Decimal(12, 4)
  unidade         String
  percentualPerda Decimal  @default(0) @db.Decimal(8, 4)
  custoCalculado  Decimal  @default(0) @db.Decimal(12, 4)
  observacao      String?
  // Posição do item na ficha (a ordem em que foi digitado; bloco 8E).
  ordem           Int      @default(0)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  fichaTecnica FichaTecnica  @relation(fields: [fichaTecnicaId], references: [id], onDelete: Cascade)
  insumo       Insumo?       @relation(fields: [insumoId], references: [id])
  preparacao   FichaTecnica? @relation("FichaTecnicaPreparacao", fields: [preparacaoId], references: [id])

  @@index([fichaTecnicaId])
  @@index([insumoId])
  @@index([preparacaoId])
}

model CategoriaInsumo {
  id        String @id @default(uuid())
  empresaId String

  nome  String
  ativo Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  insumos Insumo[]

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@index([empresaId, ativo])
}

model UnidadeMedida {
  id        String @id @default(uuid())
  empresaId String

  nome       String
  abreviacao String
  ativo      Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  insumos Insumo[]

  @@unique([empresaId, abreviacao])
  @@index([empresaId])
  @@index([empresaId, ativo])
}
