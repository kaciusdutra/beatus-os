# Configuração do servidor do Beatus. Copie este arquivo para ".env" (na pasta deploy/) e preencha.
# O ".env" NUNCA vai para o GitHub nem para mensagens: ele guarda as senhas e as chaves.
# Depois de mudar qualquer valor:  docker compose up -d   (recria só o que mudou)

# ---------- Obrigatório ----------

# O endereço do site, sem https:// (o DNS do domínio precisa apontar para o IP do servidor).
DOMINIO=beatus.exemplo.com.br

# Senha do banco. Gere uma e cole aqui:  openssl rand -hex 24
POSTGRES_PASSWORD=troque-por-uma-senha-longa-gerada

# ---------- Pagamento (Mercado Pago) ----------
# Veja docs/CHECKOUT_MERCADO_PAGO.md. Sem estes, o checkout do site fica indisponível.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# sandbox (teste) ou producao
MERCADOPAGO_AMBIENTE=sandbox

# ---------- Beatriz (IA) ----------
# Veja docs/BEATRIZ_IA.md. Sem a chave, o chat do site não aparece.
ANTHROPIC_API_KEY=
# Teto de mensagens por dia no chat do site (padrão 300; 0 desliga)
BEATRIZ_TETO_DIARIO_SITE=300

# ---------- Avisos pelo WhatsApp (Meta) ----------
# Veja docs/WHATSAPP_AVISOS.md. Sem estes, nada é enviado e os avisos ficam "aguardando envio".
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_MODELO_EM_PREPARO=
WHATSAPP_MODELO_A_CAMINHO=
WHATSAPP_MODELO_ENTREGUE=

# ---------- iFood (quando ligar) ----------
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
